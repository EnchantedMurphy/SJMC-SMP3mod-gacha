{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "gacha:ticket_single",
        "model": {"type": "minecraft:model", "model": "gacha:item/ticket_single"}
      },
      {
        "when": "gacha:ticket_ten",
        "model": {"type": "minecraft:model", "model": "gacha:item/ticket_ten"}
      }
    ],
    "fallback": {"type": "minecraft:model", "model": "minecraft:item/paper"}
  }
}
